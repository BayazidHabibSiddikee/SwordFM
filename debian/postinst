#!/bin/bash
set -e

# ── Install all system dependencies ────────────────────────────────────────
apt-get install -y \
    poppler-utils \
    tar gzip xz-utils bzip2 zstd \
    zip unzip p7zip-full \
    graphviz \
    python3 python3-pip 2>/dev/null || true

# unrar is in non-free on Debian/Ubuntu — try both package names
apt-get install -y unrar 2>/dev/null \
    || apt-get install -y unrar-free 2>/dev/null \
    || true

# ── Install Python packages ─────────────────────────────────────────────────
# Try pip install for the current user environment; fall back to --break-system-packages
# on distros that enforce PEP 668 (Ubuntu 23.04+, Debian 12+).
PIP_PKGS="pymupdf mammoth python-docx pdf2docx beautifulsoup4 markdown qrcode"

if python3 -m pip install $PIP_PKGS --quiet 2>/dev/null; then
    true
elif python3 -m pip install $PIP_PKGS --quiet --break-system-packages 2>/dev/null; then
    true
else
    # Last resort: install into /usr/local via pip with no isolation
    pip3 install $PIP_PKGS --quiet --break-system-packages 2>/dev/null || true
fi

# ── Desktop database ────────────────────────────────────────────────────────
if command -v update-desktop-database &>/dev/null; then
    update-desktop-database /usr/share/applications
fi
if command -v gtk-update-icon-cache &>/dev/null; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
fi
